{
	"folders": [
		{
			"path": "../ncs"
		},
		{
			"path": "."
		}
	],
	"settings": {
		"nrf-connect.applications": [
			"${workspaceFolder}/nrf/samples/wifi/shell",
			"${workspaceFolder}/nrf/samples/net/mqtt",
			"${workspaceFolder}/nrf/samples/zigbee/shell",
			"${workspaceFolder:iot-lectures}/packet-thread",
			"${workspaceFolder:iot-lectures}/packet",
			"${workspaceFolder}/nrf/samples/openthread/cli",
			"${workspaceFolder:iot-lectures}/coap",
			"${workspaceFolder:iot-lectures}/yr.no",
			"${workspaceFolder:iot-lectures}/bme280",
			"${workspaceFolder:iot-lectures}/blinky",
			"${workspaceFolder:iot-lectures}/scanner",
			"${workspaceFolder:iot-lectures}/template",
			"${workspaceFolder}/zephyr/samples/bluetooth/peripheral_esp",
			"${workspaceFolder:iot-lectures}/led_strip"
		],
		"nrf-connect.west.env": {
			"$base": "process"
		},
		"files.associations": {
			"sl_status.h": "c",
			"array": "c",
			"string": "c",
			"string_view": "c",
