			"*.tcc": "c",
			"fstream": "c",
			"span": "c",
			"ieee802154.h": "c",
			"openthread.h": "c",
			"coap.h": "c",
			"devicetree.h": "c",
			"compare": "c"
		},
		"nrf-connect.topdir": "${workspaceFolder}",
		"nrf-connect.toolchain.path": "${nrf-connect.toolchain:2.6.2}",
		"esbonio.sphinx.confDir": "",
		"files.insertFinalNewline": true,
		"restructuredtext.pythonRecommendation.disabled": true,
		"editor.inlayHints.enabled": "offUnlessPressed"
